# ============================================================
# Supabase Configuration
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# Email Configuration (Resend)
# Used for: OTP, password reset, notifications, device login alerts
# ============================================================
EMAIL_FROM=Dewan Ambalan <noreply@mail.da-alf.my.id>
RESEND_API_KEY=your-resend-api-key

# ============================================================
# Payment Gateway (Tripay) - Future Feature
# ============================================================
TRIPAY_API_KEY=your-tripay-api-key
TRIPAY_MERCHANT_CODE=your-merchant-code
TRIPAY_MODE=sandbox  # Use 'sandbox' for testing, 'production' for live

# ============================================================
# App Configuration
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@da-alf.my.id

# ============================================================
# Security & Analytics (Optional)
# ============================================================
# Internal analytics secret for page view tracking
# Generate with: openssl rand -hex 32
# INTERNAL_ANALYTICS_SECRET=your-random-secret

# ============================================================
# Database Connection (Direct PostgreSQL - Optional)
# ============================================================
# DATABASE_URL=postgresql://user:password@host:5432/database

# ============================================================
# Features Enabled/Disabled
# ============================================================
# Device verification & IP tracking (v13 migration required)
# No configuration needed - uses existing RESEND_API_KEY
